# ─────────────────────────────────────────────────────────────
# Scriptora — example environment variables
# Copy to .env and fill in values.
# ─────────────────────────────────────────────────────────────

# ─── Supabase (REQUIRED) ─────────────────────────────────────
VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-or-publishable-key"
VITE_SUPABASE_ANON_KEY="your-anon-or-publishable-key"

# ─── App metadata (optional) ───────────────────────────────────
VITE_APP_VERSION="1.0.0"
VITE_BUILD_CHANNEL="stable"

# ─── Owner / dev (optional) ────────────────────────────────────
VITE_SCRIPTORA_OWNER_EMAILS="you@example.com"

# ─── AI flags (optional) ───────────────────────────────────────
VITE_AI_PROVIDER="deepseek"
VITE_ENABLE_GEMINI="false"

# ═══════════════════════════════════════════════════════════════
# PAYMENTS — flip these when you are ready to sell
# See docs/payments-setup.md for the full activation checklist.
# ═══════════════════════════════════════════════════════════════

# Master switch. false = Coming Soon UI everywhere.
VITE_ENABLE_PAYMENTS="false"

# coming_soon     → modal "presto disponibile" (default, safe for launch)
# external_links  → open hosted checkout URLs (Stripe Payment Links, Lemon, Paddle)
# provider_sdk    → server creates Stripe Checkout Session (create-checkout function)
VITE_PAYMENT_MODE="coming_soon"

# none | stripe | lemonsqueezy | paddle | paypal
VITE_PAYMENT_PROVIDER="none"

# Phase 1 — hosted checkout URLs (one per plan)
VITE_PAYMENT_MONTHLY_URL=""
VITE_PAYMENT_YEARLY_URL=""
VITE_PAYMENT_PREMIUM_MONTHLY_URL=""
VITE_PAYMENT_PREMIUM_YEARLY_URL=""
VITE_PAYMENT_LIFETIME_URL=""

# Credit packs (Usage / marketplace)
VITE_PAYMENT_CREDITS_URL=""
# Optional per-pack overrides, e.g. VITE_PAYMENT_CREDITS_URL_5000=""
VITE_STRIPE_CREDITS_URL=""

# Post-checkout redirects (configure the same URLs in provider dashboards)
VITE_PAYMENT_SUCCESS_URL="/dashboard?payment=success"
VITE_PAYMENT_CANCEL_URL="/pricing?payment=cancelled"

# ─── Downloads (optional) ────────────────────────────────────
VITE_ENABLE_DOWNLOADS="false"
VITE_DOWNLOAD_MODE="coming_soon"
VITE_ANDROID_APK_URL=""
VITE_ANDROID_AAB_URL=""
VITE_MAC_DMG_URL=""
VITE_MAC_ZIP_URL=""
VITE_WINDOWS_EXE_URL=""

# ═══════════════════════════════════════════════════════════════
# SERVER-ONLY SECRETS — Supabase Edge Functions (never in .env)
#   supabase secrets set KEY=value
#
# Required for live subscription unlocks (Phase 2):
#   PAYMENT_PROVIDER=stripe|lemonsqueezy|paddle
#   STRIPE_SECRET_KEY=sk_live_...
#   STRIPE_WEBHOOK_SECRET=whsec_...
#   STRIPE_PRICE_PRO_MONTHLY=price_...
#   STRIPE_PRICE_PRO_YEARLY=price_...
#   STRIPE_PRICE_PREMIUM_MONTHLY=price_...
#   STRIPE_PRICE_PREMIUM_YEARLY=price_...
#   STRIPE_PRICE_LIFETIME=price_...
#
# Lemon Squeezy:
#   LEMON_WEBHOOK_SECRET=...
#   LEMON_VARIANT_PRO_MONTHLY=...
#   LEMON_VARIANT_PRO_YEARLY=...
#   LEMON_VARIANT_PREMIUM_MONTHLY=...
#   LEMON_VARIANT_PREMIUM_YEARLY=...
#   LEMON_VARIANT_LIFETIME=...
#
# Webhook endpoint (deploy functions first):
#   https://<project>.supabase.co/functions/v1/payments-webhook?provider=stripe
#   https://<project>.supabase.co/functions/v1/payments-webhook?provider=lemonsqueezy
#
# AI / other server secrets:
#   DEEPSEEK_API_KEY, BRAVE_SEARCH_API_KEY, FAL_KEY, etc.
# ═══════════════════════════════════════════════════════════════
